{
    "CSS Boilerplate": {
        "prefix": "css-boilerplate",
        "body": [
            "*,",
            "*::before,",
            "*::after {",
            "    box-sizing: border-box;",
            "}",
            "",
            "html {",
            "    scroll-behavior: smooth;",
            "}",
            "",
            "body {",
            "    margin: 0;",
            "    min-height: 100vh;",
            "    font-family: Arial, sans-serif;",
            "    line-height: 1.5;",
            "}",
            "",
            "img,",
            "picture,",
            "video,",
            "canvas,",
            "svg {",
            "    display: block;",
            "    max-width: 100%;",
            "}",
            "",
            "input,",
            "button,",
            "textarea,",
            "select {",
            "    font: inherit;",
            "}"
        ],
        "description": "Insert a basic CSS reset and page foundation"
    }
}
